rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == "Teacher";
    }

    function ownsStudentRecord() {
      return signedIn() && resource.data.user_id == request.auth.uid;
    }

    function ownsCheckoutRecord() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(resource.data.student_id))
        && get(/databases/$(database)/documents/students/$(resource.data.student_id)).data.user_id == request.auth.uid;
    }

    match /equipment/{equipmentId} {
      allow read: if signedIn() && (resource.data.is_active == true || isTeacher());
      allow create, update, delete: if isTeacher();
    }

    match /students/{studentId} {
      allow read: if isTeacher() || ownsStudentRecord();
      allow create, update, delete: if isTeacher();
    }

    match /checkouts/{checkoutId} {
      allow read: if isTeacher()
        || ownsCheckoutRecord()
        || (signedIn() && resource.data.checked_in_at == null);
      allow create, update: if signedIn();
      allow delete: if isTeacher();
    }

    match /student_approval_requests/{userId} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isTeacher();
    }

    match /approved_teachers/{email} {
      allow read, write: if isTeacher();
    }

    match /profiles/{userId} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isTeacher();
    }
  }
}
